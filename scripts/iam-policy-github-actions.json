{
  "Version": "2012-10-17",
  "Comment": "Minimum permissions for the CI user (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) that runs .github/workflows/deploy.yml for the cokco project. Scope the S3 statements down to the two buckets if you don't share this user across projects.",
  "Statement": [
    {
      "Sid": "TerraformState",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket", "s3:GetBucketVersioning"],
      "Resource": [
        "arn:aws:s3:::cokco-terraform-state-*",
        "arn:aws:s3:::cokco-terraform-state-*/*"
      ]
    },
    {
      "Sid": "SiteBucket",
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": [
        "arn:aws:s3:::cokco.theclouddevopslearningblog.com",
        "arn:aws:s3:::cokco.theclouddevopslearningblog.com/*"
      ]
    },
    {
      "Sid": "CloudFront",
      "Effect": "Allow",
      "Action": ["cloudfront:*"],
      "Resource": "*"
    },
    {
      "Sid": "ACM",
      "Effect": "Allow",
      "Action": [
        "acm:RequestCertificate",
        "acm:DescribeCertificate",
        "acm:ListCertificates",
        "acm:ListTagsForCertificate",
        "acm:AddTagsToCertificate",
        "acm:DeleteCertificate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Route53",
      "Effect": "Allow",
      "Action": [
        "route53:ListHostedZones",
        "route53:ListHostedZonesByName",
        "route53:GetHostedZone",
        "route53:ChangeResourceRecordSets",
        "route53:ListResourceRecordSets",
        "route53:GetChange"
      ],
      "Resource": "*"
    }
  ]
}
